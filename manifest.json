{
  "manifest_version": 3,
  "name": "World Audio 1.1.0 Beta",
  "version": "1.1.0",
  "description": "World Audio spatial audio, experimental synchronized YouTube video, and AI-assisted sound localization estimates.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "tts",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "World Audio"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "talk": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Talk to the World Audio assistant"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "world-audio-video.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: wss:"
  }
}
